{
  "name": "executable-film-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "films/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @efe/studio",
    "build": "npm run build -w @efe/studio",
    "build:single": "npm run build && node tools/package-single-html.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:core": "tsx --test packages/core/test/*.test.ts packages/fx/test/*.test.ts",
    "test:browser": "playwright test tests/cold-seek.spec.ts",
    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "render:frame": "npm run build && node tools/render-frame.mjs",
    "verify": "npm run verify:static && npm run typecheck && npm run test:core && npm run build:single",
    "verify:static": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
